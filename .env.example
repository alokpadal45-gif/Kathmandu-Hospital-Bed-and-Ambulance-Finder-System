# Copy this file to ".env" and fill in real values.
# .env itself is gitignored — never commit real secrets.

# Django
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (only required for production settings)
DB_NAME=kathmandu_emergency_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Redis (only required for production settings — Channels layer)
REDIS_URL=redis://127.0.0.1:6379/0

# Email (only required for production settings)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
